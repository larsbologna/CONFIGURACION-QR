# Copiá este archivo como .env y completá los valores.
# Puerto y dirección donde escucha el servidor (127.0.0.1 = solo esta PC).
PORT=3000
HOST=127.0.0.1

# Dominio PÚBLICO que se codifica dentro de cada QR. Se guarda en cada unidad al
# generarla y NO cambia después. Este proyecto usa GitHub Pages:
PUBLIC_BASE_URL=https://larsbologna.github.io/CONFIGURACION-QR

# Carpeta que publica GitHub Pages (Settings → Pages → rama main, carpeta /docs).
# Cada QR es el archivo docs/q/<código>.html. Dejar vacío solo si usás un servidor propio.
STATIC_DIR=docs

# Carpetas de datos (base SQLite + diseños subidos) y copias de seguridad.
DATA_DIR=./data
BACKUP_DIR=./backups

# Duración de la sesión administrativa (horas).
SESSION_HOURS=12

# true si el servidor está detrás de un proxy HTTPS (Nginx, Caddy, Render, etc.).
TRUST_PROXY=false

# Cookie solo por HTTPS: auto = activa si PUBLIC_BASE_URL empieza con https.
COOKIE_SECURE=auto

# Permitir destinos http:// (no recomendado). Por defecto solo https://
ALLOW_HTTP_DESTINATIONS=false

# Cantidad máxima de unidades por lote.
MAX_BATCH=5000
